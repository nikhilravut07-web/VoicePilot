APP_ENV=development
DATABASE_URL=sqlite:///./voicepilot.db
# A random key is generated at start when blank. Set a persistent random value for shared environments.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000
SEED_DEMO_DATA=false
# Set these only when SEED_DEMO_DATA=true. Use a unique development-only password.
# SEED_EMAIL=owner@example.com
# SEED_PASSWORD=your-unique-demo-password

